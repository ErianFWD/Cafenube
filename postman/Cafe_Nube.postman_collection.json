          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200',()=>pm.response.to.have.status(200));",
                  "pm.test('JWT ausente del JSON',()=>pm.expect(pm.response.json()).not.to.have.property('token'));",
                  "pm.test('Cookie HttpOnly',()=>pm.expect(pm.response.headers.all().filter(h=>h.key.toLowerCase()==='set-cookie').map(h=>h.value).join(';')).to.include('HttpOnly'));",
