  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.requestName==='Sin cookie rechaza perfil'){pm.collectionVariables.set('auth_correo','cafe.'+pm.variables.replaceIn('{{$guid}}')+'@example.test');pm.collectionVariables.set('auth_password','Postman_Cafe_2026');}",
          "if(!['GET','HEAD','OPTIONS'].includes(pm.request.method)&&pm.info.requestName!=='CSRF ausente rechaza escritura'){",
          "  pm.sendRequest({url:pm.variables.get('base_url')+'/auth/csrf',method:'GET'},(error,response)=>{if(error)throw error;pm.request.headers.upsert({key:'X-CSRF-Token',value:response.json().csrfToken});});",
          "}"
        ]
      }
    }
  ]
