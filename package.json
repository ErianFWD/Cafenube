{
  "name": "cafeteria-cafe-nube",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node scripts/configurar.js",
    "dev": "concurrently -k -n API,REACT \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "db:setup": "npm run db:setup --workspace backend"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  },
  "type": "module"
}
