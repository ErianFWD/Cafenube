fillColor=#F0F5F1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fontFamily=Arial;" vertex="1" parent="detalle_ventas"><mxGeometry x="0" y="109" width="350" height="32" as="geometry" /></mxCell><mxCell id="detalle_ventas_cantidad" value="&lt;span style=&quot;color:#174C3B;font-weight:bold&quot;&gt;&amp;nbsp;&lt;/span&gt; &amp;nbsp; &lt;b&gt;cantidad&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;color:#60756C&quot;&gt;integer&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fontFamily=Arial;" vertex="1" parent="detalle_ventas"><mxGeometry x="0" y="141" width="350" height="32" as="geometry" /></mxCell><mxCell id="detalle_ventas_precio_unitario_centimos" value="&lt;span style=&quot;color:#174C3B;font-weight:bold&quot;&gt;&amp;nbsp;&lt;/span&gt; &amp;nbsp; &lt;b&gt;precio_unitario_centimos&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;color:#60756C&quot;&gt;integer&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=#F0F5F1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fontFamily=Arial;" vertex="1" parent="detalle_ventas"><mxGeometry x="0" y="173" width="350" height="32" as="geometry" /></mxCell><mxCell id="cat-prod" value="1 categoría · 0..N productos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#527362;strokeWidth=2;fontColor=#2C4F3D;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="categorias" target="productos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="prod-det" value="1 producto · 0..N detalles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#527362;strokeWidth=2;fontColor=#2C4F3D;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.55;entryX=0;entryY=0.55;" edge="1" parent="1" source="productos" target="detalle_ventas"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="venta-det" value="1 venta · 1..N detalles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#527362;strokeWidth=2;fontColor=#2C4F3D;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=0;exitY=0.55;entryX=1;entryY=0.55;endArrow=ERmany;" edge="1" parent="1" source="ventas" target="detalle_ventas"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="met-venta" value="1 método · 0..N ventas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#527362;strokeWidth=2;fontColor=#2C4F3D;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;exitX=1;exitY=0.7;entryX=0;entryY=0.2;" edge="1" parent="1" source="metodos_pago" target="ventas"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="180" /><mxPoint x="945" y="486" /></Array></mxGeometry></mxCell><mxCell id="cli-venta" value="0..1 cliente por venta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#527362;strokeWidth=2;fontColor=#2C4F3D;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;startArrow=ERzeroToOne;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="clientes" target="ventas"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="reglas" value="&lt;b&gt;Reglas sencillas&lt;/b&gt;&lt;br&gt;Una venta puede registrarse sin cliente. Toda venta contiene al menos un detalle. Cada detalle pertenece a una venta y un producto.&lt;br&gt;La pareja venta + producto es única. Cantidad &amp;gt; 0; precios en céntimos de colón (CRC).&lt;br&gt;El total se calcula sumando cantidad × precio unitario. El precio de una venta anterior se conserva." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#3E594A;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1350" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="estructura-proyecto" name="02 Estructura del proyecto"><mxGraphModel dx="1420" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="990" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo2" value="Cafetería  ·  Estructura sencilla del proyecto" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontStyle=1;fontColor=#153F32;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1350" height="60" as="geometry" /></mxCell><mxCell id="frontend" value="&lt;b&gt;FRONTEND  ·  React + Vite&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;frontend/src/&lt;/b&gt;&lt;br&gt;components/  ·  formularios, tablas y confirmación&lt;br&gt;pages/  ·  inicio y pantallas de gestión&lt;br&gt;routes/  ·  rutas de la aplicación&lt;br&gt;App.jsx  ·  composición principal&lt;br&gt;main.jsx  ·  arranque de React&lt;br&gt;services/  ·  llamadas a la API&lt;br&gt;styles/  ·  estilos compartidos&lt;br&gt;&lt;br&gt;&lt;b&gt;frontend/index.html&lt;/b&gt;  ·  documento de entrada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F6F2;strokeColor=#91B29D;strokeWidth=2;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontColor=#1D4434;fontSize=19;" vertex="1" parent="1"><mxGeometry x="45" y="150" width="580" height="420" as="geometry" /></mxCell><mxCell id="backend" value="&lt;b&gt;BACKEND  ·  Node.js + Express&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;backend/src/&lt;/b&gt;&lt;br&gt;routes/  ·  endpoints /api/...&lt;br&gt;controllers/  ·  validaciones y CRUD&lt;br&gt;models/  ·  consultas parametrizadas&lt;br&gt;database/  ·  conexión y esquema SQLite&lt;br&gt;app.js  ·  configuración de Express&lt;br&gt;server.js  ·  inicio del servidor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#C7AB64;strokeWidth=2;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontColor=#614C20;fontSize=19;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="560" height="350" as="geometry" /></mxCell><mxCell id="database" value="&lt;b&gt;BASE DE DATOS  ·  SQLite&lt;/b&gt;&lt;br&gt;backend/data/cafeteria.sqlite&lt;br&gt;&lt;br&gt;categorias · productos · clientes&lt;br&gt;metodos_pago · ventas · detalle_ventas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#EAF1EF;strokeColor=#8AA69C;strokeWidth=2;fontColor=#214D3D;fontSize=19;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="855" y="640" width="530" height="180" as="geometry" /></mxCell><mxCell id="http" value="HTTP / JSON" edge="1" parent="1" source="frontend" target="backend" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#486F59;strokeWidth=2;fontSize=17;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.45;entryX=0;entryY=0.54;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sql" value="Consultas SQL" edge="1" parent="1" source="backend" target="database" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#486F59;strokeWidth=2;fontSize=17;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nota2" value="&lt;b&gt;Uso:&lt;/b&gt; abrir la aplicación, elegir una sección y crear, consultar, editar o eliminar.&lt;br&gt;La eliminación siempre pide confirmación. El proyecto no incluye login, registro, tokens ni roles." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#3E594A;" vertex="1" parent="1"><mxGeometry x="45" y="865" width="1340" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>