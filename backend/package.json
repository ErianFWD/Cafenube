{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --env-file=.env --test test/*.test.js",
    "db:setup": "node --env-file=.env src/database/setup.js",
    "db:migrate": "node --env-file=.env src/database/migrate.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.0",
    "sequelize": "^6.37.8"
  }
}
